# Ferd: Caddy site block.
#
# Caddy provisions and renews a Let's Encrypt certificate automatically.
# Replace ferd.example.com and /srv/ferd with your values.
#
# Place this in /etc/caddy/Caddyfile (or import it from there), then:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

ferd.example.com {
    root * /srv/ferd
    encode zstd gzip

    # GPX uploads are capped at 10 MiB by the API. 12 MiB gives headroom.
    request_body {
        max_size 12MB
    }

    # The root holds server files too: the database, its backups and the
    # config under tools/, every user's GPX files under users/ (the API serves
    # them only to their owner or on a published map), unit files and git.
    @blocked path /tools /tools/* /users /users/* /deploy /deploy/* /.git /.git/*
    handle @blocked {
        respond 404
    }

    # Proxy the API. Stock Caddy has no rate_limit directive, so unlike the
    # nginx example there is no proxy-layer login throttle here. The API
    # enforces its own per-IP login rate limit, which is the actual defense;
    # the nginx rule is just belt-and-suspenders. If you want a matching
    # outer limit, add the caddy-ratelimit community module.
    handle /api/* {
        reverse_proxy 127.0.0.1:8091
    }

    # The API writes the page: it sets the Content-Security-Policy and the
    # link-preview tags (docs/configure.md), and answers robots.txt and the
    # sitemap. So send the page at /, /index.html and every /u/ path, the
    # service worker and those two files through it rather than from disk,
    # and do not add a second policy here. A handle of its own keeps the
    # try_files below from rewriting /u/<name>/ to /index.html first, which
    # would lose the path the canonical link names.
    # Needs static_dir set in tools/config.json.
    @shell path / /index.html /sw.js /robots.txt /sitemap.xml /u/*
    handle @shell {
        reverse_proxy 127.0.0.1:8091
    }

    handle {
        # The modules import each other by plain URL, so a browser that
        # guesses a lifetime for one can run it against a newer page.
        header /app/* Cache-Control "no-cache"

        # Static site with SPA-style fallback; the fallback page goes through
        # the API too.
        try_files {path} /index.html
        @fallback path /index.html
        reverse_proxy @fallback 127.0.0.1:8091
        file_server
    }
}
